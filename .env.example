# ===== Firebase (client - public) =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Firebase Admin (server only - from service account JSON) =====
# RECOMMENDED: base64-encode the ENTIRE service account JSON file and set
# just this one var. Avoids all private-key newline/escaping issues:
#   base64 -w0 service-account.json        (Linux/macOS)
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))   (Windows PowerShell)
FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64=

# Alternative: paste the raw JSON as one line (still works, base64 is safer)
# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Alternative: the three separate fields (most error-prone — if you hit a
# "DECODER routines::unsupported" / private key parse error, switch to
# FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64 above instead)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===== PipraPay (piprapay.com self-hosted payment verification) =====
# Base URL of your self-hosted PipraPay instance, e.g. https://pay.yourdomain.com
PIPRAPAY_BASE_URL=
# API key generated from PipraPay merchant panel (Settings > API)
PIPRAPAY_API_KEY=
# Used to build redirect URLs after payment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Webhook shared secret (if your PipraPay instance signs webhooks) - verify in your panel
PIPRAPAY_WEBHOOK_SECRET=
